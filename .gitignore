# Python / uv
.venv/
__pycache__/
*.pyc
.pytest_cache/
dist/
build/

# The lab's original scenes, the paper and the video: never committed, wherever they land
# (the asset may be a licensed commercial model; the paper is under review)
assets/
*.mb
*.ma
*.pdf
*.mp4

# Solver runs and large analysis output that can be regenerated
runs/
refs/

# Derived data the team shares is committed on purpose, because the repo is private (docs ADR-19)
data/*
!data/lab_export/
!data/preview/
!data/briefing/
!data/tetmesh/

# Installers and binaries (the FEBio EULA forbids redistributing them)
*.exe

# FEBio outputs written next to inputs during ad-hoc runs
*.xplt
*.log

# Blender
*.blend1

# The local AI development setup is each machine's own (T-38): instruction files, hooks, settings, worktrees
# (tools/check_no_lab_files.py refuses them if tracked)
AGENTS.md
CLAUDE.md
.claude/

# This machine only: where the outside data lives. Never committed (tools/check_no_lab_files.py refuses it).
.local/
